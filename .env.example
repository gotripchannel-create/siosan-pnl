# Переменные окружения проекта siosan-pnl.
# Копия этого файла не должна содержать реальных значений — только документацию.
# На Vercel: Project Settings → Environment Variables. Локально: скопируйте в .env
# и заполните своими значениями (файл .env добавлен в .gitignore и не коммитится).

# ---------------------------------------------------------------------------
# Supabase — база данных и авторизация пользователей
# ---------------------------------------------------------------------------

# URL проекта Supabase (Project Settings → API → Project URL).
# Используется и клиентом (сборка Vite), и серверными функциями.
VITE_SUPABASE_URL=

# Публичный (anon) ключ Supabase (Project Settings → API → anon public).
# Безопасен для использования в браузере — доступ ограничен через RLS-политики.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Service Role ключ Supabase (Project Settings → API → service_role).
# СЕКРЕТНЫЙ — даёт полный доступ к базе В ОБХОД RLS. НИКОГДА не используется на
# клиенте, только в серверных функциях, которым нужно писать в базу без
# пользовательской сессии (сейчас — только api/cron-sync-invoices.js и
# api/vk-callback.js). Не публиковать, не логировать, не коммитить.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# iiko — подключение к локальному серверу ресторана (iikoServer/iikoRMS API)
# ---------------------------------------------------------------------------

# Базовый URL сервера iiko, например http://<ip-или-домен>:<порт>
IIKO_SERVER_URL=

# Логин и пароль API-пользователя iiko (заводится в iikoOffice отдельно от
# обычных пользователей, только для программного доступа).
IIKO_API_LOGIN=
IIKO_API_PASSWORD=

# ---------------------------------------------------------------------------
# Anthropic — категоризация расходов и AI-помощник
# ---------------------------------------------------------------------------

# Ключ API Anthropic (Claude) — используется для распознавания финансовых
# отчётов из текста/фото и для AI-помощника на дашборде.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Защита служебных/фоновых эндпоинтов
# ---------------------------------------------------------------------------

# Секрет для авторизации Vercel Cron при вызове /api/cron-sync-invoices, а также
# для внутренних server-to-server вызовов /api/parse-report из cron-задания.
# Vercel сам добавляет заголовок Authorization: Bearer <CRON_SECRET> при вызове
# зарегистрированных cron-задач (см. vercel.json → crons), если эта переменная
# задана. БЕЗ ЭТОЙ ПЕРЕМЕННОЙ соответствующие эндпоинты отключаются полностью
# (fail-closed) — это осознанное поведение ради безопасности, не баг.
# Сгенерировать: любая случайная строка, например `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# VKontakte Callback API — автоматический приём отчётов из чата сообщества
# (опционально — без этого блока просто не будет интеграции с VK, остальное
# приложение работает без неё)
# ---------------------------------------------------------------------------

# Строка подтверждения сервера, которую покажет ВКонтакте при настройке Callback
# API (Сообщество → Управление → Работа с API → Callback API → Подтверждение).
VK_CONFIRMATION_CODE=

# Секретный ключ, который вы сами придумываете в настройках Callback API VK и
# дублируете сюда. БЕЗ ЭТОЙ ПЕРЕМЕННОЙ приём сообщений из VK отключается
# полностью (fail-closed).
VK_CALLBACK_SECRET=

# Ключ доступа сообщества с правом "Сообщения" (Управление → Работа с API →
# Ключи доступа → Создать ключ → отметить "Сообщения"). Нужен, чтобы бот мог
# читать входящие сообщения.
VK_COMMUNITY_TOKEN=
